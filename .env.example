# Copy to this repository's .env. Never commit real API keys.
# fake is offline; explicitly select deepseek for real requests.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Bounded request costs and latency. Set retries/repairs to 0 for one API attempt.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TRANSPORT_RETRIES=1
LLM_MAX_REPAIR_ATTEMPTS=1

# Legacy DEEPSEEK_API_KEY, DEEPSEEK_BASE_URL and DEEPSEEK_MODEL are also accepted.
# Process environment takes precedence over this file; prefer the LLM_* names.
# Store real keys only in your local .env, not in scripts, docs or test fixtures.
